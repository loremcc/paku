# paku — config.yaml template
#
# Copy this file to config.yaml and fill in your values.
# config.yaml is gitignored — never commit it (contains tokens and API keys).
#
# All sections are optional. Paku runs with defaults if a section is absent.
# Paku does NOT require all sections to be configured — only what you use.

# ─── Core ──────────────────────────────────────────────────────────────────────

paku:
  log_level: INFO  # DEBUG | INFO | WARNING | ERROR

# ─── Output paths ──────────────────────────────────────────────────────────────

outputs:
  base_dir: ./output
  review_queue: ./output/review_queue.json
  checkpoint: ./output/.paku_checkpoint

# ─── Google Cloud Vision OCR ───────────────────────────────────────────────────
#
# Auth: set ONE of the three options below. Priority: env var > credentials_file > api_key.
#
# Option 1: env var (CI/CD, Docker)
#   export GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#
# Option 2 (recommended for local use): credentials_file in config.yaml
#   Set credentials_file to the absolute path of your service account JSON.
#
# Option 3: API key (simpler for personal use)
#   Create an API key in Google Cloud Console → APIs & Services → Credentials.
#   Enable "Cloud Vision API" for the key.
#   Free tier: 1,000 image annotations/month.
#
# Install the SDK first:
#   pip install "paku[ocr]"   or   pip install google-cloud-vision>=3.7

google_vision:
  credentials_file: ""  # absolute path to service account JSON (Option 2)
  api_key: ""           # API key string (Option 3)

# ─── Ollama ────────────────────────────────────────────────────────────────────
#
# Two models, same host. Install Ollama and pull both:
#   ollama pull gemma4:26b                       # text LLM for recommendations
#   ollama create gemma4-paku -f Modelfile.paku  # VLM for smart OCR re-run
#
# The VLM is used only when `paku digest --smart` is passed AND confidence < 0.4.
# The text LLM powers the dashboard Recommendations tab (For You section).
# No API keys involved — just a LAN IP and model names.

ollama:
  base_url: "http://192.168.1.114:11434"   # remote Ollama host on home network
  ocr_model: "gemma4-paku:latest"           # VLM built from Modelfile.paku (system prompt, no thinking)
  recs_model: "gemma4:26b"                  # text-only LLM for semantic recommendations

# ─── AniList ───────────────────────────────────────────────────────────────────
#
# AniList GraphQL is free and requires no auth. These defaults are correct.

anilist:
  base_url: https://graphql.anilist.co
  confidence_threshold: 0.8  # Levenshtein ratio minimum for auto-accept

# ─── Notion ────────────────────────────────────────────────────────────────────
#
# Required only when using `--push notion` or `paku enrich`.
# DB IDs: open the DB in Notion → copy the 32-char hex ID from the URL.
# CSV property headers must exactly match Notion property names (case-sensitive).

notion:
  token: ""          # Integration token from notion.so/my-integrations
  anime_db_id: ""    # 32-char Notion DB ID for anime entries
  url_db_id: ""      # 32-char Notion DB ID for URL entries
  recipe_db_id: ""   # 32-char Notion DB ID for recipe entries
